<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="Calculator" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBox 
            x:Name="Display"
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="4" 
            Text="0"
            IsReadOnly="True"
            HorizontalContentAlignment="Right"
            VerticalContentAlignment="Center"
            FontSize="32"
            Margin="10"
            Padding="10"
            Height="70"
            Focusable="False"/>

        <!--Botões 7, 8, 9-->
        <Button
            Content="7"
            Grid.Row="1"
            Grid.Column="0"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="NumberButton_Click"/>
        <Button
            Content="8"
            Grid.Row="1"
            Grid.Column="1"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="9"
            Grid.Row="1"
            Grid.Column="2"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>

        <!--Botões 4, 5 e 6-->
        <Button
            Content="4"
            Grid.Row="2"
            Grid.Column="0"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="5"
            Grid.Row="2"
            Grid.Column="1"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="6"
            Grid.Row="2"
            Grid.Column="2"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>

        <!--Botões 1, 2 e 3-->
        <Button
            Content="1"
            Grid.Row="3"
            Grid.Column="0"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="2"
            Grid.Row="3"
            Grid.Column="1"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="3"
            Grid.Row="3"
            Grid.Column="2"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>

        <!--Botões 0, ponto e igual-->
        <Button
            Content="0"
            Grid.Row="4"
            Grid.Column="0"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="."
            Grid.Row="4"
            Grid.Column="1"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="NumberButton_Click"/>
        <Button
            Content="="
            Grid.Row="4"
            Grid.Column="2"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" />
        
        <!--Operator Buttons-->
        <Button
            Content="+"
            Grid.Row="4"
            Grid.Column="3"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="OperatorButton_Click"/>
        <Button
            Content="-"
            Grid.Row="3"
            Grid.Column="3"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="OperatorButton_Click"/>
        <Button
            Content="*"
            Grid.Row="2"
            Grid.Column="3"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="OperatorButton_Click"/>
        <Button
            Content="/"
            Grid.Row="1"
            Grid.Column="3"
            FontSize="24"
            Margin="2"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" 
            Click="OperatorButton_Click"/>

    </Grid>
</Window>
